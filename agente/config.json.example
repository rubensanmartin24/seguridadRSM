{
  "agente": {
    "nombre": "Agente SeguridadRSM",
    "version": "0.1.0",
    "hostname": "hostname_placeholder",
    "descripcion": "Agente de monitorización para entornos domésticos y pymes"
  },
  "backend": {
    "url": "http://localhost:8000",
    "puerto": 8000,
    "timeout": 30,
    "reintentos": 3
  },
  "monitoreo": {
    "intervalo_reporte": 60,
    "habilitar_logs": true,
    "nivel_log": "INFO"
  },
  "modulos": {
    "collector": {
      "habilitado": true,
      "descripcion": "Recolector de eventos brutos"
    },
    "detectors": {
      "habilitado": true,
      "descripcion": "Detectores locales de amenazas"
    },
    "senders": {
      "habilitado": true,
      "descripcion": "Enviador de eventos al backend"
    }
  }
}
